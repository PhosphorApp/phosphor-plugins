<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.SiriusXM
	A source plug-in that streams SiriusXM live channels for a logged-in subscriber. Loaded
	dynamically by the host from its plugins/ folder — there is deliberately NO project reference
	from the host back to this project. It references ONLY the Phosphor plug-in contract,
	compile-only (the host supplies the single shared runtime copy).

	Playback design (PROXY STYLE B): the plug-in runs a tiny local HLS proxy. It passes the SXM
	variant playlist through, rewrites the EXT-X-KEY URI to a local endpoint that serves the
	static AES-128 key, and injects the SXM auth token params onto segment requests. LibVLC then
	fetches + AES-decrypts the segments itself. The host plays the local http://127.0.0.1 URL via
	its existing StreamUrl -> new Media -> Play path (no ffmpeg in the playback path).
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.SiriusXM</AssemblyName>
	<RootNamespace>Phosphor.Plugins.SiriusXM</RootNamespace>
	<Version>1.0.1</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.15.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
	<!-- Bundled default super-group map (Music/Talk/Sports → category keys). Copied to output and
		 deployed; a user copy in the instance cache dir overrides it at runtime. -->
	<None Update="categories.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<!-- Also deploy the bundled map alongside the plug-in (shared Directory.Build.targets copies
		 PhosphorPluginExtraDeployFiles into plugins/SiriusXM/). Reference the SOURCE file (which
		 always exists), not $(TargetDir)/Exists(...): those resolve at static-evaluation time —
		 before Build populates $(TargetDir) — so on a clean build the condition is false and the
		 json silently never deploys. -->
	<PhosphorPluginExtraDeployFiles Include="$(MSBuildProjectDirectory)\categories.json" />
  </ItemGroup>

</Project>
