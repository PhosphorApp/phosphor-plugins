<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.HdHomeRun
	A source plug-in that surfaces the live TV lineup of a SiliconDust HDHomeRun network tuner
	(https://www.silicondust.com/). It talks to the tuner's local HTTP API (/discover.json for
	device specifics, /lineup.json for the channel lineup) and plays each channel's MPEG-TS stream.
	Loaded dynamically by the host from its plugins/ folder — there is deliberately NO project
	reference from the host back to this project. It references ONLY the Phosphor plug-in contract,
	compile-only (the host supplies the single shared runtime copy).
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.HdHomeRun</AssemblyName>
	<RootNamespace>Phosphor.Plugins.HdHomeRun</RootNamespace>
	<Version>1.0.0</Version>
	<!-- Not packed/published as an app; just a class library the host scans. -->
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
