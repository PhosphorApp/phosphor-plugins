<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.Twitch
	A source plug-in that browses and plays Twitch content. Loaded dynamically from the host's
	plugins/ folder — no project reference from the host back to this project. References ONLY the
	Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Like Dailymotion it reuses the host-bundled yt-dlp for playback (mature twitch:* extractors) and
	discovery is KEYLESS: Twitch's public GraphQL endpoint (gql.twitch.tv) answers search / channel /
	directory queries with the well-known anonymous web Client-ID — no OAuth, no account, no token.
	Twitch is live-first, so live streams flow through the host's IsLiveStream path; VODs are finite
	and seekable.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.Twitch</AssemblyName>
	<RootNamespace>Phosphor.Plugins.Twitch</RootNamespace>
	<Version>1.0.1</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
	  <ExcludeAssets>runtime</ExcludeAssets>
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<!-- Plug-in-owned template defining the authoritative default channel groups. Copied to the
		 plug-in output and self-deployed to the host so it sits next to the DLL at runtime. Edit it
		 to rename/add/remove default groups without recompiling. -->
	<Content Include="default_channel_groups.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<!-- Also deploy the bundled json alongside the plug-in (shared Directory.Build.targets copies
		 PhosphorPluginExtraDeployFiles into plugins/Twitch/). Reference the SOURCE file (which always
		 exists), not $(TargetDir): that is resolved at static-evaluation time — before Build
		 populates $(TargetDir) — so on a clean build the condition is false and it never deploys. -->
	<PhosphorPluginExtraDeployFiles Include="$(MSBuildProjectDirectory)\default_channel_groups.json" />
  </ItemGroup>

</Project>
