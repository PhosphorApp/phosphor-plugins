<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.Dailymotion
	A source plug-in that browses and plays Dailymotion videos. Loaded dynamically from the host's
	plugins/ folder — no project reference from the host back to this project. References ONLY the
	Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Like Vimeo it reuses the host-bundled yt-dlp for playback, but discovery is KEYLESS: the
	Dailymotion public API (api.dailymotion.com) allows search / categories / paged listing with no
	OAuth and no token (spike-proven), so there is no credential setting at all.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.Dailymotion</AssemblyName>
	<RootNamespace>Phosphor.Plugins.Dailymotion</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\Phosphor.Plugin.Abstractions\Phosphor.Plugin.Abstractions.csproj">
	  <Private>false</Private>
	  <ExcludeAssets>runtime</ExcludeAssets>
	</ProjectReference>
  </ItemGroup>

  <!-- Self-deploy into the host's plugins/Dailymotion/ folder on build (mirrors Vimeo/Jellyfin). -->
  <Target Name="SelfDeployToHost" AfterTargets="Build">
	<PropertyGroup>
	  <HostPluginDest>$(MSBuildThisFileDirectory)..\Phosphor\bin\$(Configuration)\net8.0-windows\plugins\Dailymotion</HostPluginDest>
	</PropertyGroup>
	<ItemGroup>
	  <SelfDeployFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Phosphor.Plugin.Abstractions.dll" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
	</ItemGroup>
	<MakeDir Directories="$(HostPluginDest)" />
	<Copy SourceFiles="@(SelfDeployFiles)" DestinationFolder="$(HostPluginDest)" SkipUnchangedFiles="false" />
	<Message Importance="high" Text="Dailymotion plug-in self-deployed to $(HostPluginDest)" />
  </Target>

</Project>
