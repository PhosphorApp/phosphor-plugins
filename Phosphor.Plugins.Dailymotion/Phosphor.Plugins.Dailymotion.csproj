<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.Dailymotion
	A source plug-in that browses and plays Dailymotion videos. Loaded dynamically from the host's
	plugins/ folder — no project reference from the host back to this project. References ONLY the
	Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Like Vimeo it reuses the host-bundled yt-dlp for playback, but discovery is KEYLESS: the
	Dailymotion public API (api.dailymotion.com) allows search / categories / paged listing with no
	OAuth and no token (spike-proven), so there is no credential setting at all.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.Dailymotion</AssemblyName>
	<RootNamespace>Phosphor.Plugins.Dailymotion</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\Phosphor.Plugin.Abstractions\Phosphor.Plugin.Abstractions.csproj">
	  <Private>false</Private>
	  <ExcludeAssets>runtime</ExcludeAssets>
	</ProjectReference>
  </ItemGroup>

</Project>
