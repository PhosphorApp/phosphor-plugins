<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.LocalFolder
	A reference third-party source plug-in: plays media files from user-configured local folders.
	Loaded dynamically by the host from its plugins/ folder — there is deliberately NO project
	reference from the host back to this project. It references ONLY the Phosphor plug-in contract,
	compile-only (the host supplies the single shared runtime copy), so it doubles as the template
	proving the contract is complete without host internals.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.LocalFolder</AssemblyName>
	<RootNamespace>Phosphor.Plugins.LocalFolder</RootNamespace>
	<Version>1.0.0</Version>
	<!-- Not packed/published as an app; just a class library the host scans. -->
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TagLibSharp reads embedded tags (artist/album/track/duration/year) from media files during
      a rescan. A clean third-party NuGet dependency, part of what makes this a realistic template.
    -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
