# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Visual Studio backup files (created during edits by some VS tooling)
*.Backup.tmp
*.backup.tmp

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
**/packages/repositories.config

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Allow DirectOutput dependency DLLs (overrides x64/x86 ignore above)
!dependencies/DirectOutput/
!dependencies/DirectOutput/x64/
!dependencies/DirectOutput/x64/DirectOutput.dll
!dependencies/DirectOutput/x86/
!dependencies/DirectOutput/x86/DirectOutput.dll

# ProjectM presets (extracted locally, not tracked)
dependencies/projectM/presets-cream-of-the-crop-master/

# SiriusXM spike — never commit local credentials
tools/SiriusXmSpike/sxm.local.json
tools/SiriusXmSpike/*.local

# Spotify spike — never commit the sp_dc cookie
tools/SpotifySpike/spotify.local.json
tools/SpotifySpike/*.local

# Throwaway diagnostic spike projects (SkiaSharp/emoji rendering tests, etc.)
_spike_*/

# Draft app license — kept local only until finalized
LICENSE.draft.txt

# Stray empty files the IDE/tooling occasionally recreates at old edit paths
# (the real sources live at Phosphor/Caching/PrefetchCache.cs and Phosphor/Emoji/EmojiRenderer.cs)
Phosphor/Services/PrefetchCache.cs
Phosphor/Visuals/EmojiRenderer.cs

# Plugin self-deploy output (PHOSPHOR_HOST_DIR unset)
dist/

# Local NuGet feed config (machine-specific: local abstractions feed)
nuget.config

