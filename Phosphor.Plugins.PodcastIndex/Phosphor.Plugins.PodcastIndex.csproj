<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.PodcastIndex
	A source plug-in that indexes and plays podcasts via the Podcast Index API (podcastindex.org).
	Loaded dynamically by the host from its plugins/ folder — there is deliberately NO project
	reference from the host back to this project. It references ONLY the Phosphor plug-in contract,
	compile-only (the host supplies the single shared runtime copy).

	Playback design (LEAN — no proxy, no yt-dlp): Podcast Index is a pure INDEX. Its episode
	responses carry a direct, non-DRM enclosureUrl (an .mp3/.m4a/.mp4 the publisher hosts).
	ResolveAsync just hands that https://…/episode.mp3 URL to the host's existing StreamUrl ->
	new Media -> Play path. Episodes are finite/seekable (real Duration), so items are NOT marked
	IsLiveStream. Requires a per-user, free API key + secret (Option B) — the API is a keyed
	index, so each request is signed with an Amazon-style SHA-1 auth header.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.PodcastIndex</AssemblyName>
	<RootNamespace>Phosphor.Plugins.PodcastIndex</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
