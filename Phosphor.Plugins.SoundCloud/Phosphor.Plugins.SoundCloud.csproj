<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.SoundCloud
	A source plug-in that browses and plays SoundCloud audio tracks. Loaded dynamically from the
	host's plugins/ folder — no project reference from the host back to this project. References ONLY
	the Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Like Dailymotion, discovery is KEYLESS — but SoundCloud has no public keyless REST API, so BOTH
	discovery (search / genre browse) and playback ride the host-bundled yt-dlp. yt-dlp's mature
	SoundCloud extractor auto-derives a client_id, so no OAuth, no token, and no setting are needed.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.SoundCloud</AssemblyName>
	<RootNamespace>Phosphor.Plugins.SoundCloud</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
	<!--
	  EXPERIMENTAL: much SoundCloud content (major-label catalog) is DRM-protected and unplayable
	  through yt-dlp. Rather than hide the source, the plug-in advertises itself as experimental
	  (IExperimental) and does "lazy discovery": it remembers tracks that fail to resolve
	  (IPlaybackReportable) and surfaces them as unplayable (SourceItem.IsPlayable = false) on future
	  searches. Set DisableSoundCloudPlugin to true to stop deploying it into the host's plugins/ folder.
	-->
	<DisableSoundCloudPlugin>false</DisableSoundCloudPlugin>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\Phosphor.Plugin.Abstractions\Phosphor.Plugin.Abstractions.csproj">
	  <Private>false</Private>
	  <ExcludeAssets>runtime</ExcludeAssets>
	</ProjectReference>
  </ItemGroup>

  <!--
	Self-deploy into the host's plugins/SoundCloud/ folder on build (mirrors Dailymotion/Vimeo).
	Skipped while DisableSoundCloudPlugin is true.
  -->
  <Target Name="SelfDeployToHost" AfterTargets="Build" Condition="'$(DisableSoundCloudPlugin)' != 'true'">
	<PropertyGroup>
	  <HostPluginDest>$(MSBuildThisFileDirectory)..\Phosphor\bin\$(Configuration)\net8.0-windows\plugins\SoundCloud</HostPluginDest>
	</PropertyGroup>
	<ItemGroup>
	  <SelfDeployFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Phosphor.Plugin.Abstractions.dll" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
	</ItemGroup>
	<MakeDir Directories="$(HostPluginDest)" />
	<Copy SourceFiles="@(SelfDeployFiles)" DestinationFolder="$(HostPluginDest)" SkipUnchangedFiles="false" />
	<Message Importance="high" Text="SoundCloud plug-in self-deployed to $(HostPluginDest)" />
  </Target>

  <!--
	While disabled, actively remove any previously-deployed copy so the host stops discovering it
	after a rebuild (mirrors the deploy path). Runs only when DisableSoundCloudPlugin is true.
  -->
  <Target Name="UndeployFromHost" AfterTargets="Build" Condition="'$(DisableSoundCloudPlugin)' == 'true'">
	<PropertyGroup>
	  <HostPluginDest>$(MSBuildThisFileDirectory)..\Phosphor\bin\$(Configuration)\net8.0-windows\plugins\SoundCloud</HostPluginDest>
	</PropertyGroup>
	<RemoveDir Directories="$(HostPluginDest)" Condition="Exists('$(HostPluginDest)')" />
	<Message Importance="high" Text="SoundCloud plug-in is DISABLED — removed any deployed copy at $(HostPluginDest)" />
  </Target>

</Project>

