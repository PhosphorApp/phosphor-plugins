<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.YouTube
	The YouTube source plug-in. Loaded dynamically by the host from its plugins/ folder — there is
	deliberately NO project reference from the host back to this project. It references ONLY the
	Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Unlike the tool-only plug-ins (Vimeo/Dailymotion), YouTube carries the YoutubeExplode managed
	library as a PRIVATE runtime dependency, loaded lazily inside this plug-in's AssemblyLoadContext.
	The yt-dlp engine path shells out to the host-bundled yt-dlp.exe via IPluginHost.GetToolPath —
	the exe is NOT shipped here (it is a shared host tool). ffmpeg is likewise host-owned.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.YouTube</AssemblyName>
	<RootNamespace>Phosphor.Plugins.YouTube</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
	<!-- Private managed dependency: ships in the plug-in folder, loaded in this plug-in's ALC. -->
	<PackageReference Include="YoutubeExplode" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
	<!-- Plug-in-owned template defining the authoritative initial YouTube category list. Copied to
		 the plug-in output and self-deployed to the host so it sits next to the DLL at runtime. -->
	<Content Include="default_categories.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<!-- Code-tunable yt-dlp download-throttle knobs (anti-403). Testers edit this next to the DLL
		 and restart; no recompile. Only the on/off master switch is a user setting. -->
	<Content Include="download_throttle.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<!-- Also deploy these bundled json files alongside the plug-in (shared Directory.Build.targets
		 copies PhosphorPluginExtraDeployFiles into plugins/YouTube/). Reference the SOURCE files
		 (which always exist), not $(TargetDir)/Exists(...): those are resolved at static-evaluation
		 time — before Build populates $(TargetDir) — so on a clean build the condition is false and
		 the json files silently never deploy. -->
	<PhosphorPluginExtraDeployFiles Include="$(MSBuildProjectDirectory)\default_categories.json" />
	<PhosphorPluginExtraDeployFiles Include="$(MSBuildProjectDirectory)\download_throttle.json" />
  </ItemGroup>

</Project>
