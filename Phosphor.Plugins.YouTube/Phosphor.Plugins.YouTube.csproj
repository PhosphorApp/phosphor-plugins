<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.YouTube
	The YouTube source plug-in. Loaded dynamically by the host from its plugins/ folder — there is
	deliberately NO project reference from the host back to this project. It references ONLY the
	Phosphor plug-in contract, compile-only (the host supplies the single shared runtime copy).

	Unlike the tool-only plug-ins (Vimeo/Dailymotion), YouTube carries the YoutubeExplode managed
	library as a PRIVATE runtime dependency, loaded lazily inside this plug-in's AssemblyLoadContext.
	The yt-dlp engine path shells out to the host-bundled yt-dlp.exe via IPluginHost.GetToolPath —
	the exe is NOT shipped here (it is a shared host tool). ffmpeg is likewise host-owned.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.YouTube</AssemblyName>
	<RootNamespace>Phosphor.Plugins.YouTube</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<ProjectReference Include="..\Phosphor.Plugin.Abstractions\Phosphor.Plugin.Abstractions.csproj">
	  <Private>false</Private>
	  <ExcludeAssets>runtime</ExcludeAssets>
	</ProjectReference>
  </ItemGroup>

  <ItemGroup>
	<!-- Private managed dependency: ships in the plug-in folder, loaded in this plug-in's ALC. -->
	<PackageReference Include="YoutubeExplode" Version="6.6.0" />
  </ItemGroup>

  <!--
	Self-deploy: copy this plug-in's output into the host's plugins/YouTube/ folder whenever THIS
	project builds, so a plain Build always refreshes the deployed DLLs (no stale-plugin surprises).
	The shared contract is excluded (the host owns the single runtime copy). Runs unconditionally so
	incremental builds can't skip it. Mirrors the Vimeo/Jellyfin plug-ins.
  -->
  <Target Name="SelfDeployToHost" AfterTargets="Build">
	<PropertyGroup>
	  <HostPluginDest>$(MSBuildThisFileDirectory)..\Phosphor\bin\$(Configuration)\net8.0-windows\plugins\YouTube</HostPluginDest>
	</PropertyGroup>
	<ItemGroup>
	  <SelfDeployFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Phosphor.Plugin.Abstractions.dll" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	  <SelfDeployFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
	</ItemGroup>
	<MakeDir Directories="$(HostPluginDest)" />
	<Copy SourceFiles="@(SelfDeployFiles)" DestinationFolder="$(HostPluginDest)" SkipUnchangedFiles="false" />
	<Message Importance="high" Text="YouTube plug-in self-deployed to $(HostPluginDest)" />
  </Target>

</Project>
