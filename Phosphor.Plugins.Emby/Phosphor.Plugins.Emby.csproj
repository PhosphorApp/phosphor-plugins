<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugins.Emby
	A source plug-in that browses and plays music/video from a self-hosted Emby server for a
	logged-in user. Loaded dynamically by the host from its plugins/ folder — there is deliberately
	NO project reference from the host back to this project. It references ONLY the Phosphor plug-in
	contract, compile-only (the host supplies the single shared runtime copy).

	Emby and Jellyfin share nearly identical REST APIs (Jellyfin began as a fork of Emby), so this
	plug-in mirrors Phosphor.Plugins.Jellyfin. Like Jellyfin there is NO local proxy and NO
	live-stream handling: Emby returns direct, long-lived HTTP stream URLs for finite, seekable
	tracks (the Plex shape). Playback goes straight through the host's existing StreamUrl -> new
	Media -> Play path.

	STEREO (2.1) NOTE: pinball cabs route surround channels to exciters for mechanical/ball sounds,
	so playback must be limited to 2 channels. A "Stereo audio" setting asks Emby to transcode /
	downmix to 2 channels (MaxAudioChannels=2), mirroring the Plex source's stereo option.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugins.Emby</AssemblyName>
	<RootNamespace>Phosphor.Plugins.Emby</RootNamespace>
	<Version>1.0.0</Version>
	<IsPackable>false</IsPackable>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Compile-only reference to the contract: the host owns the single runtime copy so contract
	  types unify across the load boundary (Private=false / ExcludeAssets=runtime).
	-->
	<PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.14.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
